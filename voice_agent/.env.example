# Copy to .env and adjust. Everything runs locally.

# LiveKit server (`livekit-server --dev` uses devkey / secret). Not needed for `console` mode.
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# NeMo-Speech.cpp riva_server
RIVA_SERVER=127.0.0.1:50051
# Remote gateway mode on the agent (unset for direct Riva). See GATEWAY.md.
# STT_GATEWAY_URL=wss://gateway.internal/stt
ASR_MAX_SPEAKERS=4
SUPPRESS_BACKGROUND_SPEAKER=1

# OpenAI-compatible LLM (Ollama by default)
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=qwen3:8b
LLM_API_KEY=local

# OpenAI-compatible TTS (this repo's VibeVoice API by default)
TTS_BASE_URL=http://127.0.0.1:8000/v1
TTS_MODEL=vibevoice/VibeVoice-1.5B
TTS_VOICE=alloy
TTS_API_KEY=local

# filters (option 1) | shadow (plain LiveKit, option 1/2 decisions only logged)
# | adaptive_local (option 2) | vad (plain LiveKit, for A/B)
INTERRUPTION_MODE=filters
# Replayable log of agent states, STT events and decisions (filters / shadow)
# DECISION_LOG=logs/{room}-{ts}.jsonl

# VAD and audio enhancement (independent of INTERRUPTION_MODE)
# VAD_BACKEND: silero | aic (ai-coustics VAD model) | aic_enhancer (flag from the enhancer)
VAD_BACKEND=silero
# AUDIO_ENHANCEMENT: none | aic (ai-coustics Quail / Voice Focus on room input; not in console mode)
AUDIO_ENHANCEMENT=none
# AIC_LICENSE_KEY=...                      # developers.ai-coustics.com; never commit it
AIC_ENHANCER_MODEL=quail_vf_l             # quail_vf_l | quail_vf_s | quail_l | rook_s
# AIC_ENHANCEMENT_LEVEL=1.0
AIC_ENHANCER_VAD_HOLD_S=0.55              # hold before the enhancer VAD reports silence
AIC_VAD_MODEL=vad-2.1-xxs-16khz
# AIC_VAD_MODEL_PATH=/path/vad-2.1-xxs-16khz.aicmodel   # offline: skip the CDN download
AIC_VAD_THRESHOLD=0.5
AIC_TELEMETRY=0                           # 0: no OpenTelemetry export, DO_NOT_TRACK=1

# Option 1
FILTER_GRACE_S=1.0
INTERIM_MIN_WORDS=3
MAAI_ENABLED=0
MAAI_DEVICE=cpu
MAAI_THRESHOLD=0.45

# Option 2: the agent's AdaptiveInterruptionDetector talks to the local bargein server.
# The same key/secret sign (agent) and verify (server) the JWT.
LIVEKIT_INFERENCE_URL=http://127.0.0.1:8765
LIVEKIT_INFERENCE_API_KEY=local
LIVEKIT_INFERENCE_API_SECRET=replace-with-a-long-random-string
BARGEIN_PORT=8765
BARGEIN_THRESHOLD=0.5
# BARGEIN_DECISION_LOG=logs/bargein-decisions.jsonl

# Gateway host only: Voice Focus enhancement before Nemotron, and overlap VAD.
# GATEWAY_STT_ENABLED=1
# GATEWAY_AIC_ENABLED=1
# GATEWAY_AIC_VAD_ENABLED=1
# GATEWAY_AIC_VAD_MODEL=vad-vf-2.0-s-16khz
# GATEWAY_AIC_VAD_GATE_THRESHOLD=0.2  # optional; calibrate before enabling
# BARGEIN_HOST=0.0.0.0
