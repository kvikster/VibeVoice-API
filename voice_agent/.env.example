# Copy to .env and adjust. Everything runs locally.

# LiveKit server (`livekit-server --dev` uses devkey / secret). Not needed for `console` mode.
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# NeMo-Speech.cpp riva_server
RIVA_SERVER=127.0.0.1:50051
ASR_MAX_SPEAKERS=4
SUPPRESS_BACKGROUND_SPEAKER=1

# OpenAI-compatible LLM (Ollama by default)
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=qwen3:8b
LLM_API_KEY=local

# OpenAI-compatible TTS (this repo's VibeVoice API by default)
TTS_BASE_URL=http://127.0.0.1:8000/v1
TTS_MODEL=vibevoice/VibeVoice-1.5B
TTS_VOICE=alloy
TTS_API_KEY=local

# filters (option 1) | adaptive_local (option 2) | vad (plain LiveKit, for A/B)
INTERRUPTION_MODE=filters

# Option 1
FILTER_GRACE_S=1.0
INTERIM_MIN_WORDS=3
MAAI_ENABLED=0
MAAI_DEVICE=cpu
MAAI_THRESHOLD=0.45

# Option 2: the agent's AdaptiveInterruptionDetector talks to the local bargein server.
# The same key/secret sign (agent) and verify (server) the JWT.
LIVEKIT_INFERENCE_URL=http://127.0.0.1:8765
LIVEKIT_INFERENCE_API_KEY=local
LIVEKIT_INFERENCE_API_SECRET=replace-with-a-long-random-string
BARGEIN_PORT=8765
BARGEIN_THRESHOLD=0.5
